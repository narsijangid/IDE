# OLKIL website deploy config
# Copy to .env.deploy and fill in your Hostinger SSH details from hPanel → Advanced → SSH Access

# SSH user from Hostinger (Websites → SSH Access)
SSH_USER=u623589745

# SSH host from hPanel (e.g. srv123.hostinger.com or IP)
SSH_HOST=YOUR_SSH_HOST

# Hostinger usually uses port 65002
SSH_PORT=65002

# production | testing
# production → olkil.com
# testing    → testing.olkil.com
DEPLOY_TARGET=testing
