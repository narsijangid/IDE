{
  "name": "olkil",
  "displayName": "OLKIL AI Code Editor",
  "description": "OLKIL AI Code Editor for VS Code — AI coding agent, chat, autocomplete alternative, and pair programmer. Write, debug, refactor, and ship faster. Cursor alternative, Copilot alternative, Claude Code alternative, Codex alternative in Visual Studio Code.",
  "version": "1.0.94",
  "publisher": "OLKIL",
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A0A0B",
    "theme": "dark"
  },
  "homepage": "https://olkil.com",
  "bugs": {
    "url": "https://olkil.com"
  },
  "qna": "https://olkil.com",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai code editor",
    "olkil",
    "olkil ai",
    "ai coding agent",
    "ai coding assistant",
    "vscode ai",
    "vs code ai",
    "ai pair programmer",
    "cursor alternative",
    "github copilot alternative",
    "copilot alternative",
    "claude code alternative",
    "codex alternative",
    "chatgpt for vscode",
    "ai code completion",
    "ai autocomplete",
    "code generator ai",
    "ai debugger",
    "ai refactor",
    "agentic coding",
    "ai chat vscode",
    "llm code editor",
    "powerful ide",
    "virtual office"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "olkil.chat.toggle",
        "title": "OLKIL: Toggle Chat",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "olkil.chat.new",
        "title": "New Chat",
        "category": "OLKIL",
        "icon": "$(add)"
      },
      {
        "command": "olkil.chat.history",
        "title": "History",
        "category": "OLKIL",
        "icon": "$(history)"
      },
      {
        "command": "olkil.askSelection",
        "title": "OLKIL: Ask about Selection"
      },
      {
        "command": "olkil.signIn",
        "title": "Sign In",
        "category": "OLKIL",
        "icon": "$(sign-in)"
      },
      {
        "command": "olkil.signOut",
        "title": "Sign out",
        "category": "OLKIL"
      },
      {
        "command": "olkil.settings.open",
        "title": "Settings",
        "category": "OLKIL",
        "icon": "$(gear)"
      },
      {
        "command": "olkil.openWebsite",
        "title": "OLKIL: Open olkil.com"
      },
      {
        "command": "olkil.openDesktop",
        "title": "OLKIL: Open Desktop App"
      },
      {
        "command": "olkil.virtualOffice.toggle",
        "title": "Vertual Office",
        "shortTitle": "Vertual Office",
        "icon": {
          "light": "media/vo-tab-icon.png",
          "dark": "media/vo-tab-icon.png"
        }
      },
      {
        "command": "olkil.pocket.toggle",
        "title": "OLKIL: Toggle Pocket",
        "category": "OLKIL"
      }
    ],
    "keybindings": [
      {
        "command": "olkil.chat.toggle",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !terminalFocus"
      },
      {
        "command": "olkil.chat.new",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "olkil.askSelection",
          "when": "editorHasSelection",
          "group": "olkil@1"
        }
      ],
      "commandPalette": [
        {
          "command": "olkil.askSelection",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "olkil.chat.new",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "olkil.chat.history",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "olkil.settings.open",
          "when": "view == olkil.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "olkil.signOut",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "olkil.virtualOffice.toggle",
          "group": "navigation@0",
          "when": "true"
        },
        {
          "command": "olkil.chat.toggle",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "olkil.signIn",
          "group": "navigation@2",
          "when": "!olkil.signedIn"
        }
      ],
      "layoutControl": [
        {
          "command": "olkil.chat.toggle",
          "group": "navigation@0"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "olkil",
          "title": "OLKIL",
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "olkil": [
        {
          "type": "webview",
          "id": "olkil.sidebar",
          "name": "OLKIL",
          "retainContextWhenHidden": true,
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "configuration": {
      "title": "OLKIL",
      "properties": {
        "olkil.authOrigin": {
          "type": "string",
          "default": "https://olkil.com",
          "description": "OLKIL account origin used for sign-in and plan checks."
        },
        "olkil.chat.defaultMode": {
          "type": "string",
          "enum": ["agent", "ask"],
          "enumDescriptions": ["Edit files and run commands", "Answer only, no tools"],
          "default": "agent",
          "description": "Mode for new chats."
        },
        "olkil.terminal.autoRun": {
          "type": "string",
          "enum": ["always", "allowlist", "never"],
          "enumDescriptions": [
            "Run every command without asking (destructive commands still ask)",
            "Run allowlisted commands; ask for everything else",
            "Ask before every command"
          ],
          "default": "allowlist",
          "description": "When the agent may run terminal commands without asking."
        },
        "olkil.terminal.allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "git status", "git diff", "git log", "git show", "git branch", "git rev-parse",
            "ls", "dir", "pwd", "cd", "echo", "cat", "type", "head", "tail", "wc", "tree", "rg", "grep", "findstr",
            "where", "which", "Get-ChildItem", "Get-Content", "Get-Location", "Test-Path", "Select-String",
            "Select-Object", "Sort-Object", "Measure-Object", "node -v", "node --version", "npm -v", "npm --version",
            "npm ls", "npm view", "npm test", "npm run test", "npm run lint", "yarn test", "pnpm test",
            "python --version", "tsc --noEmit", "npx tsc --noEmit"
          ],
          "description": "Command prefixes the agent may run without asking. \"npm install\" allows \"npm install anything\"."
        },
        "olkil.permissions.webFetch": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent fetch public URLs (docs, APIs) without asking."
        },
        "olkil.git.allowCommit": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent run git commit without asking."
        },
        "olkil.git.allowPush": {
          "type": "boolean",
          "default": false,
          "description": "Let the agent run git push without asking."
        },
        "olkil.git.allowPullRequest": {
          "type": "boolean",
          "default": false,
          "description": "Let the agent open pull requests (gh / glab) without asking."
        },
        "olkil.privacy.keepChatHistory": {
          "type": "boolean",
          "default": true,
          "description": "Sync your last chats to your OLKIL account (3 chats, 48 hours)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
