{
  "name": "olkil",
  "displayName": "OLKIL AI Code Editor",
  "description": "OLKIL AI Code Editor for VS Code — AI coding agent, chat, autocomplete alternative, and pair programmer. Write, debug, refactor, and ship faster. Cursor alternative, Copilot alternative, Claude Code alternative, Codex alternative in Visual Studio Code.",
  "version": "1.0.93",
  "publisher": "OLKIL",
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A0A0B",
    "theme": "dark"
  },
  "homepage": "https://olkil.com",
  "bugs": {
    "url": "https://olkil.com"
  },
  "qna": "https://olkil.com",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai code editor",
    "olkil",
    "olkil ai",
    "ai coding agent",
    "ai coding assistant",
    "vscode ai",
    "vs code ai",
    "ai pair programmer",
    "cursor alternative",
    "github copilot alternative",
    "copilot alternative",
    "claude code alternative",
    "codex alternative",
    "chatgpt for vscode",
    "ai code completion",
    "ai autocomplete",
    "code generator ai",
    "ai debugger",
    "ai refactor",
    "agentic coding",
    "ai chat vscode",
    "llm code editor",
    "powerful ide",
    "virtual office"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "olkil.chat.toggle",
        "title": "OLKIL: Toggle Chat",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "olkil.chat.new",
        "title": "New Chat",
        "category": "OLKIL",
        "icon": "$(add)"
      },
      {
        "command": "olkil.chat.history",
        "title": "History",
        "category": "OLKIL",
        "icon": "$(history)"
      },
      {
        "command": "olkil.askSelection",
        "title": "OLKIL: Ask about Selection"
      },
      {
        "command": "olkil.signIn",
        "title": "Sign In",
        "category": "OLKIL",
        "icon": "$(sign-in)"
      },
      {
        "command": "olkil.signOut",
        "title": "Sign out",
        "category": "OLKIL"
      },
      {
        "command": "olkil.openWebsite",
        "title": "OLKIL: Open olkil.com"
      },
      {
        "command": "olkil.openDesktop",
        "title": "OLKIL: Open Desktop App"
      },
      {
        "command": "olkil.virtualOffice.toggle",
        "title": "Vertual Office",
        "shortTitle": "Vertual Office",
        "icon": {
          "light": "media/vo-tab-icon.png",
          "dark": "media/vo-tab-icon.png"
        }
      },
      {
        "command": "olkil.pocket.toggle",
        "title": "OLKIL: Toggle Pocket",
        "category": "OLKIL"
      }
    ],
    "keybindings": [
      {
        "command": "olkil.chat.toggle",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !terminalFocus"
      },
      {
        "command": "olkil.chat.new",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "olkil.askSelection",
          "when": "editorHasSelection",
          "group": "olkil@1"
        }
      ],
      "commandPalette": [
        {
          "command": "olkil.askSelection",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "olkil.chat.new",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "olkil.chat.history",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "olkil.signOut",
          "when": "view == olkil.sidebar && olkil.signedIn",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "olkil.virtualOffice.toggle",
          "group": "navigation@0",
          "when": "true"
        },
        {
          "command": "olkil.chat.toggle",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "olkil.signIn",
          "group": "navigation@2",
          "when": "!olkil.signedIn"
        }
      ],
      "layoutControl": [
        {
          "command": "olkil.chat.toggle",
          "group": "navigation@0"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "olkil",
          "title": "OLKIL",
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "olkil": [
        {
          "type": "webview",
          "id": "olkil.sidebar",
          "name": "OLKIL",
          "retainContextWhenHidden": true,
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "configuration": {
      "title": "OLKIL",
      "properties": {
        "olkil.authOrigin": {
          "type": "string",
          "default": "https://olkil.com",
          "description": "OLKIL account origin used for sign-in and plan checks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
