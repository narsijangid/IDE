# Copy to .env (gitignored). Live keys: replace these and set PAYU_MODE=live.
PAYU_KEY=YOUR_PAYU_TEST_MERCHANT_KEY
PAYU_SALT=YOUR_PAYU_TEST_MERCHANT_SALT
PAYU_MODE=test
INTERNAL_SECRET=generate-a-long-random-hex
SITE_URL=https://olkil.com
MAIL_FROM=OLKIL Billing <narsi@olkil.com>
MAIL_BCC=narsi@olkil.com
# Optional SMTP (Hostinger). If empty, emails are sent via WordPress wp_mail relay.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
