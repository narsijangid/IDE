# Copy to .env (gitignored). Do not put live KEY/SALT in git.
# Production: firebase functions:secrets:set PAYU_KEY / PAYU_SALT / INTERNAL_SECRET
PAYU_KEY=YOUR_PAYU_MERCHANT_KEY
PAYU_SALT=YOUR_PAYU_MERCHANT_SALT
PAYU_MODE=live
INTERNAL_SECRET=generate-a-long-random-hex
SITE_URL=https://olkil.com
MAIL_FROM=OLKIL <hi@olkil.com>
MAIL_BCC=hi@olkil.com
# Optional SMTP (Hostinger). If empty, emails are sent via WordPress wp_mail relay.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
