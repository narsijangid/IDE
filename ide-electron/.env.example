# Do not commit real keys
#
# Auto-update feed (Hostinger). Packaged apps poll this URL.
OLKIL_UPDATE_URL=https://updates.olkil.com
# Optional: mirror releases to GitHub (also used by publish-update.js)
# GH_TOKEN=ghp_xxx
# OLKIL_GH_OWNER=narsijangid
# OLKIL_GH_REPO=IDE

# Local free / unlimited: install Ollama, then `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional dummy key (Ollama does not require a real key)
# OLLAMA_API_KEY=ollama

# DeepSeek V4 Flash (OpenAI-compatible) — https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Poolside Laguna S 2.1 (OpenAI-compatible) — https://inference.poolside.ai
POOLSIDE_API_KEY=your_poolside_key

# Cap completion tokens (keeps cloud bills low)
# OLKIL_MAX_TOKENS=1600
