rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{secret} {
      allow read, write: if secret.size() == 64;
      match /tasks/{taskId} {
        allow read, write: if secret.size() == 64;
      }
      match /box/{docId} {
        allow read, write: if secret.size() == 64;
      }
    }
  }
}
